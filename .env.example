# ----------------------------------------------------
# ReTech Environment Variables
# ----------------------------------------------------

# Environment
NODE_ENV=development

# Cloud Database (Turso / LibSQL)
DATABASE_URL="libsql://your-database-name-here.turso.io"
DATABASE_AUTH_TOKEN="your_auth_token_here"
# Note: For local development using local file, use: DATABASE_URL="file:./dev.db"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Backend API Configuration
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=retech_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# SMTP / Email Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="ReTech Security <no-reply@retech.eco>"

# Firebase Web Authentication Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="re-tech-placement.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="re-tech-placement"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="re-tech-placement.firebasestorage.app"
